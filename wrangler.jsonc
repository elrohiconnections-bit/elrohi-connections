{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "elrohi-connections",
  "main": "./worker.js",
  "compatibility_date": "2026-10-24",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "elrohi-partners",
      "database_id": "d425926b-f687-416b-a26d-9f11a07e6026"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RESOURCE_FILES",
      "bucket_name": "elrohi-resources"
    }
  ]
}
